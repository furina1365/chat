{
  "server": {
    "host": "0.0.0.0",
    "port": 53411,
    "io_threads": 14,
    "worker_threads": 16,
    "business_threads": 4,
    "business_queue_size": 64,
    "model_queue_size": 8
  },
  "mysql": {
    "host": "127.0.0.1",
    "port": 3306,
    "database": "example_db",
    "username": "example_user",
    "pool_size": 8,
    "acquire_timeout_ms": 1000,
    "connect_timeout_seconds": 5,
    "io_timeout_seconds": 5,
    "password": "replace-with-your-mysql-password"
  },
  "redis": {
    "host": "127.0.0.1",
    "port": 6379,
    "username": "",
    "database": 0,
    "pool_size": 8,
    "acquire_timeout_ms": 1000,
    "connect_timeout_ms": 3000,
    "io_timeout_ms": 3000,
    "password": ""
  },
  "auth": {
    "admin_password_hash": "",
    "registration_enabled": true,
    "min_password_length": 8,
    "max_password_length": 128,
    "key_namespace": "example:auth:account",
    "login_attempts": 10,
    "login_window_seconds": 300,
    "operation_attempts": 20,
    "operation_window_seconds": 60,
    "password_verification_seconds": 300,
    "session_namespace": "example:auth:session",
    "session_idle_seconds": 86400,
    "cookie_name": "example_chat_session",
    "secure_cookie": true,
    "allowed_origins": []
  },
  "email": {
    "key_namespace": "example:auth:email",
    "code_timeout_seconds": 600,
    "resend_interval_seconds": 60,
    "max_code_attempts": 5,
    "smtp": {
      "host": "",
      "port": 465,
      "security": "tls",
      "username": "",
      "from_address": "",
      "from_name": "",
      "ca_file": "",
      "timeout_ms": 10000,
      "password": ""
    }
  },
  "models": [
    {
      "provider": "example-provider",
      "api": "openai-completions",
      "base_url": "https://api.example.invalid/v1",
      "model": "example-model",
      "max_output_tokens": 4096,
      "temperature": null,
      "top_p": null,
      "timeout_ms": 60000,
      "connect_timeout_ms": 10000,
      "max_response_bytes": 4194304,
      "max_stream_bytes": 67108864,
      "max_sse_event_bytes": 262144,
      "api_key": "replace-with-your-model-api-key"
    }
  ]
}
